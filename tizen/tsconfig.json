{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2019", "es2020.bigint", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
