# Copy to .env (git-ignored) and fill in what you use. The apps read it at build time: Flutter
# with --dart-define-from-file=../.env, the Samsung TV app (tizen/) by itself. Nothing in it is
# written in the code, so each one who builds the apps uses their own.

# TMDB key for trending titles, posters and trailers (themoviedb.org → Settings → API; free for
# non-commercial use). The short "API Key" (32 letters and digits), not the long "API Read Access
# Token": the apps send it as api_key, which the token is not
TMDB_API_KEY=

# Your sync server (server/), the one the sign-in form starts with
SYNC_SERVER=

# A language model for recommendations (OpenAI-compatible chat completions); optional
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# For the provider tests only: an Xtream account; more are numbered _1, _2...
XTREAM_CODE=
XTREAM_USERNAME=
XTREAM_PASSWORD=
