# Settings for docker compose: copy this file to .env beside docker-compose.yml and fill it in.
# .env stays on this machine (it is not committed), so every later "docker compose up" keeps them.

# The DNS name pointing at this machine (Caddy gets its certificate)
SYNC_DOMAIN=sync.example.com

# Accounts only with this invitation code, which you give to whoever may have one. Empty
# (SIGNUP_CODE=): no new accounts at all, those there are keep working. Removing the line stops
# compose.
SIGNUP_CODE=a-code-you-share

# 1 lets anyone who finds the server make an account when there is no code (a public server)
SIGNUP_OPEN=

# The whole database's cap, in MB: past it, no new accounts nor more data, and the devices say to
# ask you for more space (0: no limit)
MAX_DATA_MB=2048

# Space per account, in MB (0: no limit)
QUOTA_MB=50

# Recommendations from a language model, through any service with the OpenAI chat API (optional)
AI_MODEL=
AI_BASE_URL=https://ollama.com/v1
AI_API_KEY=
