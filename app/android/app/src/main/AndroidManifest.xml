<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Whether the network is mobile data, for trailers "Only on Wi-Fi" (granted with no prompt) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Updates from the account's sync server, through Android's installer (it asks the user) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Sound that goes on in the background, with its controls in a notification (an option) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Finding Chromecasts: Wi-Fi drops the multicast (mDNS) answers unless an app holds this lock -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Recordings scheduled from the guide, made in the background with a notification saying so;
         the processor kept awake meanwhile, so they start on time with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Keeps the CPU and Wi-Fi awake while a cast plays through this device's relay -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Waiting for one, the app is woken at its time (a recording the user scheduled, as a calendar
         event): nothing needs to run meanwhile -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- The notification of a recording under way; asked for when one is first made, never at start -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Asked once, as the first recording is scheduled on a phone: a phone that saves battery hard
         could end the app, or hold its wake-up, before the time -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- A restart forgets the wake-up for the next recording: set again as the device starts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- One APK for phones, tablets and TVs: Android TV and Fire TV have no touchscreen -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!-- Landscape only, like a TV; this keeps stores from hiding the app on devices that cannot rotate -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false"/>

    <application
        android:label="Capy TV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true">
        <!-- Not in Google's backup nor moved to a new phone: the preferences came back without the
             Keystore key of the passwords, and the lists with them. Sync and the companion page move
             them whole -->
        <!-- IPTV streams, guides and logos are very often plain http:// -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="navigation|touchscreen|mcc|mnc|colorMode|fontWeightAdjustment|orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <!-- Landscape on a tablet too, which Android 16 would otherwise turn as it pleases -->
            <property
              android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
              android:value="true"/>
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Shows the app on the Android TV / Google TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- capytv://open/pair?... from another device's companion page: move lists between them -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="capytv" android:host="open" android:pathPrefix="/pair"/>
            </intent-filter>
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <receiver
            android:name=".RecordingAlarm"
            android:exported="false"/>
        <!-- Only Android itself sends the device's start -->
        <receiver
            android:name=".RecordingBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- Hands an update the app downloaded to Android's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/updates"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Trailers open in the YouTube app or the browser -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
