---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import capyIcon from '../assets/brand/capy-icon.svg';
import capyEmpty from '../assets/brand/capy-empty.svg';
import { GITHUB_URL, local } from '../config';
import en from '../i18n/en.json';
import es from '../i18n/es.json';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const home = local(lang === 'es' ? 'es/' : '');
const other = local(lang === 'es' ? '' : 'es/');

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', { eager: true });
const shot = (name: string) => shots[`../assets/shots/${lang}/${name}.png`].default;

const posterFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/posters/*.png', { eager: true });
const posters = Object.values(posterFiles).map((m) => m.default);

// Each column starts somewhere else in the catalog, and repeats itself so its drift can loop
const columns = Array.from({ length: 7 }, (_, c) =>
  Array.from({ length: 6 }, (_, i) => posters[(c * 11 + i * 5 + 3) % posters.length]),
);

const icons = {
  home: 'M220-180h150v-220q0-12.75 8.63-21.38Q387.25-430 400-430h160q12.75 0 21.38 8.62Q590-412.75 590-400v220h150v-390L480-765 220-570v390Zm-60 0v-390q0-14.25 6.38-27 6.37-12.75 17.62-21l260-195q15.68-12 35.84-12Q500-825 516-813l260 195q11.25 8.25 17.63 21 6.37 12.75 6.37 27v390q0 24.75-17.62 42.37Q764.75-120 740-120H560q-12.75 0-21.37-8.63Q530-137.25 530-150v-220H430v220q0 12.75-8.62 21.37Q412.75-120 400-120H220q-24.75 0-42.37-17.63Q160-155.25 160-180Zm320-293Z',
  screens: 'm140-800 58 119q7.73 15.4 22.08 24.2Q234.44-648 251-648q32.5 0 49.25-27.46T303-732l-33-68h89l58 119q7.73 15.4 22.08 24.2Q453.44-648 470-648q32.5 0 49.25-27.46T522-732l-33-68h89l58 119q7.73 15.4 22.08 24.2Q672.44-648 689-648q32.5 0 49.25-27.46T741-732l-33-68h112q24 0 42 18t18 42v520q0 24-18 42t-42 18H140q-24 0-42-18t-18-42v-520q0-24 18-42t42-18Zm0 212v368h680v-368H140Zm0 0v368-368Z',
  features: 'M30-240q-12.75 0-21.37-8.63Q0-257.25 0-270v-23q0-38.57 41.5-62.78Q83-380 150.38-380q12.16 0 23.39.5t22.23 2.15q-8 17.35-12 35.17-4 17.81-4 37.18v65H30Zm240 0q-12.75 0-21.37-8.63Q240-257.25 240-270v-35q0-32 17.5-58.5T307-410q32-20 76.5-30t96.5-10q53 0 97.5 10t76.5 30q32 20 49 46.5t17 58.5v35q0 12.75-8.62 21.37Q702.75-240 690-240H270Zm510 0v-65q0-19.86-3.5-37.43T765-377.27q11-1.73 22.17-2.23 11.17-.5 22.83-.5 67.5 0 108.75 23.77T960-293v23q0 12.75-8.62 21.37Q942.75-240 930-240H780Zm-480-60h360v-6q0-37-50.5-60.5T480-390q-79 0-129.5 23.5T300-305v5ZM149.57-410q-28.57 0-49.07-20.56Q80-451.13 80-480q0-29 20.56-49.5Q121.13-550 150-550q29 0 49.5 20.5t20.5 49.93q0 28.57-20.5 49.07T149.57-410Zm660 0q-28.57 0-49.07-20.56Q740-451.13 740-480q0-29 20.56-49.5Q781.13-550 810-550q29 0 49.5 20.5t20.5 49.93q0 28.57-20.5 49.07T809.57-410ZM480-480q-50 0-85-35t-35-85q0-51 35-85.5t85-34.5q51 0 85.5 34.5T600-600q0 50-34.5 85T480-480Zm.35-60Q506-540 523-557.35t17-43Q540-626 522.85-643t-42.5-17q-25.35 0-42.85 17.15t-17.5 42.5q0 25.35 17.35 42.85t43 17.5ZM480-300Zm0-300Z',
  channels: 'm429-379 181-116q14-8.79 14-24.89Q624-536 610-545L429-661q-15-10-30.5-1T383-635v230q0 18 15.5 27t30.5-1ZM140-200q-24 0-42-18t-18-42v-520q0-24 18-42t42-18h680q24 0 42 18t18 42v520q0 24-18 42t-42 18H630v50q0 12.75-8.62 21.37Q612.75-120 600-120H360q-12.75 0-21.37-8.63Q330-137.25 330-150v-50H140Zm0-60h680v-520H140v520Zm0 0v-520 520Z',
  project: 'm166-482 176 176q9 9 8.5 21t-9.5 21q-9 9-21.5 9t-21.5-9L101-461q-5-5-7-10t-2-11q0-6 2-11t7-10l200-200q9-9 21.5-9t21.5 9q9 9 9 21.5t-9 21.5L166-482Zm628 0L618-658q-9-9-8.5-21t9.5-21q9-9 21.5-9t21.5 9l197 197q5 5 7 10t2 11q0 6-2 11t-7 10L659-261q-9 9-21 8.5t-21-9.5q-9-9-9-21.5t9-21.5l177-177Z',
};
const navItems = [
  { id: 'top', label: t.nav.home, icon: icons.home },
  { id: 'screens', label: t.nav.screens, icon: icons.screens },
  { id: 'features', label: t.nav.features, icon: icons.features },
  { id: 'channels', label: t.nav.channels, icon: icons.channels },
  { id: 'project', label: t.nav.project, icon: icons.project },
];
---

<Base lang={t.lang} title={t.meta.title} description={t.meta.description}>
  <nav class="rail" aria-label="Capy TV">
    <a class="rail-logo" href={home} aria-label="Capy TV">
      <img src={capyIcon.src} alt="" width="48" height="48" />
      <span class="rail-name">Capy TV</span>
    </a>
    <ul class="rail-links">
      {
        navItems.map((item) => (
          <li>
            <a href={`#${item.id}`} data-spy={item.id}>
              <svg viewBox="0 -960 960 960" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="rail-lang" href={other} lang={lang === 'es' ? 'en' : 'es'} aria-label={t.nav.otherName}>{t.nav.other}</a>
  </nav>

  <main>
    <header class="hero" id="top">
      <div class="wall" aria-hidden="true">
        {
          columns.map((column, c) => (
            <div class="wall-column" style={`--drift:${84 + ((c * 37) % 60)}s`}>
              {[...column, ...column].map((poster) => (
                <Image src={poster} alt="" width={280} quality={62} format="webp" loading="eager" />
              ))}
            </div>
          ))
        }
      </div>
      <div class="hero-text">
        <h1><span>{t.hero.line1}</span> <span>{t.hero.line2}</span></h1>
        <p class="hero-body">{t.hero.body}</p>
        <div class="actions">
          <a class="button primary" href={GITHUB_URL}>{t.hero.github}</a>
          <a class="button" href="#channels">{t.hero.channels}</a>
        </div>
        <p class="hero-note">
          <img src={capyEmpty.src} alt="" width="40" height="40" />
          {t.hero.note}
        </p>
      </div>
    </header>

    <section class="screens" id="screens">
      <h2 class="section-title inset">{t.screens.title}</h2>
      <div class="screen-rail" tabindex="0" role="region" aria-label={t.screens.region}>
        {
          t.screens.items.map((item, i) => (
            <figure>
              <Image
                src={shot(item.shot)}
                alt={item.alt}
                widths={[640, 1100, 1600, 2200]}
                sizes="(max-width: 900px) 90vw, 62vw"
                format="webp"
                quality={78}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="screens-note inset">{t.screens.note}</p>
    </section>

    <section class="features inset" id="features">
      <h2 class="section-title">{t.features.title}</h2>

      <article class="signature wide">
        <div class="signature-text">
          <h3>{t.features.handoff.title}</h3>
          <p>{t.features.handoff.body}</p>
        </div>
        <div class="handoff-crop">
          <Image
            src={shot('handoff')}
            alt={t.features.handoff.alt}
            widths={[1100, 1600, 2200, 2880]}
            sizes="(max-width: 900px) 230vw, 90vw"
            format="webp"
            quality={78}
            loading="lazy"
          />
        </div>
      </article>

      <article class="signature">
        <div class="signature-text">
          <h3>{t.features.profiles.title}</h3>
          <p>{t.features.profiles.body}</p>
        </div>
        <Image
          class="signature-shot"
          src={shot('profiles')}
          alt={t.features.profiles.alt}
          widths={[640, 1100, 1600, 2200]}
          sizes="(max-width: 900px) 100vw, 55vw"
          format="webp"
          quality={78}
          loading="lazy"
        />
      </article>

      <article class="signature flip">
        <div class="signature-text">
          <h3>{t.features.sync.title}</h3>
          <p>{t.features.sync.body}</p>
        </div>
        <div class="vault">
          <div>
            <h4>{t.features.sync.yours}</h4>
            <ul>{t.features.sync.plain.map((line) => <li>{line}</li>)}</ul>
          </div>
          <div>
            <h4>{t.features.sync.server}</h4>
            <ul class="cipher" aria-label={t.features.sync.cipherLabel}>
              <li>x9Kf2vQe7ZLp0tYb4NwR1sUc8HjM5aGd</li>
              <li>T3mPq8LzV6yBn2WkE0rXf7JhS4uCo9Ai</li>
              <li>hD5gN1cRt8ZsK3vYx7QbM0pLe6WfJ2Ua</li>
            </ul>
          </div>
        </div>
      </article>

      <h3 class="more-title">{t.features.moreTitle}</h3>
      <ul class="more">
        {
          t.features.more.map((item) => (
            <li>
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="night">
      <div class="night-text">
        <h2>{t.night.title}</h2>
        <p>{t.night.body}</p>
      </div>
      <Image
        src={shot('movie-night')}
        alt={t.night.alt}
        widths={[640, 1100, 1600, 2200]}
        sizes="(max-width: 900px) 100vw, 60vw"
        format="webp"
        quality={78}
        loading="lazy"
      />
    </section>

    <section class="channels inset" id="channels">
      <h2 class="section-title">{t.channels.title}</h2>
      <p class="section-body">{t.channels.body}</p>

      <div class="guide">
        <div class="guide-head" aria-hidden="true">
          <span></span>
          <div class="track">
            <span class="head-now">{t.channels.now}</span>
            <span class="head-later">{t.channels.later}</span>
          </div>
        </div>
        <ul aria-label={t.channels.list}>
          {
            t.channels.rows.map((row) => (
              <li class="guide-row">
                <span class="guide-channel">{row.name}</span>
                <div class="track">
                  <div class:list={['programme', row.state]}>{row.state === 'now' ? t.channels.yes : t.channels.no}</div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <a class="button primary" href={GITHUB_URL}>{t.channels.github}</a>
    </section>

    <section class="project inset" id="project">
      <div>
        <h2 class="section-title">{t.project.title}</h2>
        <p class="section-body">{t.project.body}</p>
        <p class="project-built">{t.project.built}</p>
        <a class="button primary" href={GITHUB_URL}>{t.project.github}</a>
      </div>
      <div>
        <h3>{t.project.helpTitle}</h3>
        <ul class="help">{t.project.help.map((line) => <li>{line}</li>)}</ul>
      </div>
    </section>

    <section class="faq inset">
      <h2 class="section-title">{t.faq.title}</h2>
      <div class="faq-list">
        {
          t.faq.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="footer inset">
    <img src={capyIcon.src} alt="" width="40" height="40" />
    <p>Capy TV. <a href="https://www.mozilla.org/MPL/2.0/">{t.footer.license}</a>.</p>
    <p class="footer-tmdb">{t.footer.tmdb}</p>
  </footer>
</Base>

<script>
  // Lights up the rail's link for the section in view
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => [a.dataset.spy!, a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links.values()) link.removeAttribute('aria-current');
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>
